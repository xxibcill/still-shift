                            "items": {
                              "type": "object",
                              "properties": {
                                "at": {
                                  "type": "object",
                                  "properties": {
                                    "cue": {
                                      "type": "string",
                                      "maxLength": 128,
                                      "pattern": "^[a-zA-Z][\\w-]*$"
                                    },
                                    "edge": {
                                      "default": "start",
                                      "type": "string",
                                      "enum": ["start", "end"]
                                    },
                                    "offsetSamples": {
                                      "default": 0,
