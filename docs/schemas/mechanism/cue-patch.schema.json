                                    "cue": {
                                      "type": "string",
                                      "maxLength": 128,
                                      "pattern": "^[a-zA-Z][\\w-]*$"
                                    },
                                    "edge": {
                                      "default": "start",
                                      "type": "string",
                                      "enum": ["start", "end"]
                                    },
                                    "offsetSamples": {
                                      "default": 0,
                                      "type": "integer",
                                      "minimum": -172800000,
                                      "maximum": 172800000
