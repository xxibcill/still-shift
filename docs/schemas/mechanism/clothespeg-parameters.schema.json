{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "armLength": { "default": 6, "type": "number", "minimum": 5, "maximum": 8 },
    "armWidth": {
      "default": 0.8,
      "type": "number",
      "minimum": 0.6,
      "maximum": 1.1
    },
    "clothThickness": {
      "default": 0.16,
      "type": "number",
      "minimum": 0.1,
      "maximum": 0.3
    }
  },
  "required": ["armLength", "armWidth", "clothThickness"],
  "additionalProperties": false
}
