{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pivot": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 }
      ]
    },
    "applicationPoint": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 }
      ]
    },
    "axis": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 }
      ]
    },
    "forceDirection": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 }
      ]
    },
    "scaleToMeters": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "resistingTorque": {
      "type": "object",
      "properties": {
        "value": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "unit": { "type": "string", "enum": ["N*m", "N*mm"] }
      },
      "required": ["value", "unit"],
      "additionalProperties": false
    }
  },
  "required": [
    "pivot",
    "applicationPoint",
    "axis",
    "forceDirection",
    "scaleToMeters",
    "resistingTorque"
  ],
  "additionalProperties": false
}
