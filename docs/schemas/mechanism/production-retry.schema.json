{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "mechanism-production-retry-1"
    },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 30 },
    "baseHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "episodes": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      }
    }
  },
  "required": ["schemaVersion", "baseRevision", "baseHash", "episodes"],
  "additionalProperties": false
}
