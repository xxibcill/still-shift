                  ]
                }
              ]
            }
          },
          "required": [
            "coilCenter",
            "axis",
            "coilRadius",
            "wireRadius",
            "turns",
            "pitch",
            "coilSamples",
            "legSamples",
            "tubeSides",
            "terminalTangents"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "mesh",
        "ownerPart",
        "topologySha256",
        "landmarks",
        "generator",
        "seats",
        "parameters"
      ],
      "additionalProperties": false
    }
  ]
}
