                { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                { "type": "number", "minimum": -1000000, "maximum": 1000000 }
              ]
            },
            "axis": {
              "type": "array",
              "prefixItems": [
                { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                { "type": "number", "minimum": -1000000, "maximum": 1000000 }
              ]
            },
            "coilRadius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "wireRadius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "turns": { "type": "number", "minimum": 0.5, "maximum": 12 },
            "pitch": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "coilSamples": { "type": "integer", "minimum": 8, "maximum": 96 },
            "legSamples": { "type": "integer", "minimum": 2, "maximum": 16 },
            "tubeSides": { "type": "integer", "minimum": 3, "maximum": 8 },
            "terminalTangents": {
