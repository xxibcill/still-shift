{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "blender-episode-plates-1" },
    "producerProfileSha256": { "type": "string" },
    "frameCount": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2000 },
    "sequence": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "bytes", "sha256"],
      "additionalProperties": false
    },
    "frames": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "capture": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "required": ["path", "bytes", "sha256"],
            "additionalProperties": false
          },
          "producer": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "required": ["path", "bytes", "sha256"],
            "additionalProperties": false
          },
          "captureFrame": { "type": "integer", "minimum": 0, "maximum": 1999 },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "image": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "required": ["path", "bytes", "sha256"],
            "additionalProperties": false
          },
          "observation": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "required": ["path", "bytes", "sha256"],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "capture",
          "producer",
          "captureFrame",
          "frame",
          "image",
          "observation"
        ],
        "additionalProperties": false
      }
    },
    "freshNativeRenders": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reusedOutputFrames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "freshCaptures": {
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "required": ["path", "bytes", "sha256"],
        "additionalProperties": false
      }
    },
    "cacheRejections": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "diagnostic": { "type": "string", "maxLength": 1024 }
        },
        "required": ["key", "diagnostic"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "producerProfileSha256",
    "frameCount",
    "sequence",
    "frames",
    "freshNativeRenders",
    "reusedOutputFrames",
    "freshCaptures",
    "cacheRejections"
  ],
  "additionalProperties": false
}
