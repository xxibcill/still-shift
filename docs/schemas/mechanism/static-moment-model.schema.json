{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][\\w.-]*$"
    },
    "pivotAnchor": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][\\w.-]*$"
    },
    "applicationAnchor": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][\\w.-]*$"
    },
    "referencePart": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][\\w.-]*$"
    },
    "axis": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 }
      ]
    },
    "forceDirection": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        { "type": "number", "minimum": -1000000, "maximum": 1000000 }
      ]
    },
    "resistingTorque": {
      "type": "object",
      "properties": {
        "value": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "unit": { "type": "string", "enum": ["N*m", "N*mm"] }
      },
      "required": ["value", "unit"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "pivotAnchor",
    "applicationAnchor",
    "referencePart",
    "axis",
    "forceDirection",
    "resistingTorque"
  ],
  "additionalProperties": false
}
