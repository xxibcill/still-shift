{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "solid-geometry-2" },
    "meshes": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "partId": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "materialId": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "positions": {
            "minItems": 9,
            "maxItems": 300000,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "normals": {
            "minItems": 9,
            "maxItems": 300000,
            "type": "array",
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          },
          "uvs": {
            "maxItems": 200000,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "indices": {
            "minItems": 3,
            "maxItems": 600000,
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 99999 }
          },
          "groups": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "count": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "materialIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                }
              },
              "required": ["start", "count", "materialIndex"],
              "additionalProperties": false
            }
          },
          "bounds": {
            "type": "object",
            "properties": {
              "min": {
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 }
                ]
              },
              "max": {
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 }
                ]
              }
            },
            "required": ["min", "max"],
            "additionalProperties": false
          },
          "tangents": {
            "minItems": 12,
            "maxItems": 400000,
            "type": "array",
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "required": [
          "id",
          "partId",
          "materialId",
          "positions",
          "normals",
          "indices",
          "bounds"
        ],
        "additionalProperties": false
      }
    },
    "materials": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "native-pbr-material-1"
          },
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "baseColorFactor": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ]
          },
          "metallicFactor": { "type": "number", "minimum": 0, "maximum": 1 },
          "roughnessFactor": { "type": "number", "minimum": 0, "maximum": 1 },
          "alphaMode": { "type": "string", "const": "OPAQUE" },
          "doubleSided": { "type": "boolean" },
          "baseColorTexture": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z][\\w.-]*$"
              },
              "texCoord": { "type": "number", "const": 0 },
              "sampler": {
                "type": "object",
                "properties": {
                  "magFilter": {
                    "anyOf": [
                      { "type": "number", "const": 9728 },
                      { "type": "number", "const": 9729 }
                    ]
                  },
                  "minFilter": {
                    "anyOf": [
                      { "type": "number", "const": 9728 },
                      { "type": "number", "const": 9729 },
                      { "type": "number", "const": 9984 },
                      { "type": "number", "const": 9985 },
                      { "type": "number", "const": 9986 },
                      { "type": "number", "const": 9987 }
                    ]
                  },
                  "wrapS": {
                    "anyOf": [
                      { "type": "number", "const": 33071 },
                      { "type": "number", "const": 33648 },
                      { "type": "number", "const": 10497 }
                    ]
                  },
                  "wrapT": {
                    "anyOf": [
                      { "type": "number", "const": 33071 },
                      { "type": "number", "const": 33648 },
                      { "type": "number", "const": 10497 }
                    ]
                  }
                },
                "required": ["magFilter", "minFilter", "wrapS", "wrapT"],
                "additionalProperties": false
              },
              "colorSpace": { "type": "string", "const": "srgb" }
            },
            "required": ["image", "texCoord", "sampler", "colorSpace"],
            "additionalProperties": false
          },
          "metallicRoughnessTexture": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z][\\w.-]*$"
              },
              "texCoord": { "type": "number", "const": 0 },
              "sampler": {
                "type": "object",
                "properties": {
                  "magFilter": {
                    "anyOf": [
                      { "type": "number", "const": 9728 },
                      { "type": "number", "const": 9729 }
                    ]
                  },
                  "minFilter": {
                    "anyOf": [
                      { "type": "number", "const": 9728 },
                      { "type": "number", "const": 9729 },
                      { "type": "number", "const": 9984 },
                      { "type": "number", "const": 9985 },
                      { "type": "number", "const": 9986 },
                      { "type": "number", "const": 9987 }
                    ]
                  },
                  "wrapS": {
                    "anyOf": [
                      { "type": "number", "const": 33071 },
                      { "type": "number", "const": 33648 },
                      { "type": "number", "const": 10497 }
                    ]
                  },
                  "wrapT": {
                    "anyOf": [
                      { "type": "number", "const": 33071 },
                      { "type": "number", "const": 33648 },
                      { "type": "number", "const": 10497 }
                    ]
                  }
                },
                "required": ["magFilter", "minFilter", "wrapS", "wrapT"],
                "additionalProperties": false
              },
              "colorSpace": { "type": "string", "const": "linear" },
              "roughnessChannel": { "type": "string", "const": "g" },
              "metalnessChannel": { "type": "string", "const": "b" }
            },
            "required": [
              "image",
              "texCoord",
              "sampler",
              "colorSpace",
              "roughnessChannel",
              "metalnessChannel"
            ],
            "additionalProperties": false
          },
          "normalTexture": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z][\\w.-]*$"
              },
              "texCoord": { "type": "number", "const": 0 },
              "sampler": {
                "type": "object",
                "properties": {
                  "magFilter": {
                    "anyOf": [
                      { "type": "number", "const": 9728 },
                      { "type": "number", "const": 9729 }
                    ]
                  },
                  "minFilter": {
                    "anyOf": [
                      { "type": "number", "const": 9728 },
                      { "type": "number", "const": 9729 },
                      { "type": "number", "const": 9984 },
                      { "type": "number", "const": 9985 },
                      { "type": "number", "const": 9986 },
                      { "type": "number", "const": 9987 }
                    ]
                  },
                  "wrapS": {
                    "anyOf": [
                      { "type": "number", "const": 33071 },
                      { "type": "number", "const": 33648 },
                      { "type": "number", "const": 10497 }
                    ]
                  },
                  "wrapT": {
                    "anyOf": [
                      { "type": "number", "const": 33071 },
                      { "type": "number", "const": 33648 },
                      { "type": "number", "const": 10497 }
                    ]
                  }
                },
                "required": ["magFilter", "minFilter", "wrapS", "wrapT"],
                "additionalProperties": false
              },
              "colorSpace": { "type": "string", "const": "linear" },
              "scale": { "type": "number", "minimum": -16, "maximum": 16 }
            },
            "required": ["image", "texCoord", "sampler", "colorSpace", "scale"],
            "additionalProperties": false
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "baseColorFactor",
          "metallicFactor",
          "roughnessFactor",
          "alphaMode",
          "doubleSided"
        ],
        "additionalProperties": false
      }
    },
    "images": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "pixelSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "encoding": { "type": "string", "const": "rgba8-straight-top-left-1" }
        },
        "required": [
          "id",
          "sourceSha256",
          "pixelSha256",
          "width",
          "height",
          "encoding"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "meshes", "materials", "images"],
  "additionalProperties": false
}
