{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "mechanism-production-queue-state-1"
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 31 },
    "manifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "codeSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "profileSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "updatedUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "rows": {
      "minItems": 1,
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "identityHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "requestHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "passed", "failed", "cancelled"]
          },
          "attempts": {
            "maxItems": 96,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": { "type": "integer", "minimum": 1, "maximum": 96 },
                "revision": { "type": "integer", "minimum": 0, "maximum": 31 },
                "requestHash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "running",
                    "passed",
                    "failed",
                    "cancelled",
                    "interrupted"
                  ]
                },
                "stage": { "type": "string", "minLength": 1, "maxLength": 128 },
                "startedUtc": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "endedUtc": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    },
                    { "type": "null" }
                  ]
                },
                "seconds": {
                  "anyOf": [
                    { "type": "number", "minimum": 0, "maximum": 86400 },
                    { "type": "null" }
                  ]
                },
                "diagnostic": {
                  "anyOf": [
                    { "type": "string", "maxLength": 2048 },
                    { "type": "null" }
                  ]
                },
                "finding": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "message": { "type": "string", "maxLength": 1024 },
                    "path": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          { "type": "string", "maxLength": 128 },
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        ]
                      }
                    },
                    "frame": { "type": "number" },
                    "interval": {
                      "type": "object",
                      "properties": {
                        "startFrame": { "type": "number" },
                        "endFrameExclusive": { "type": "number" }
                      },
                      "required": ["startFrame", "endFrameExclusive"],
                      "additionalProperties": false
                    },
                    "rig": { "type": "string", "maxLength": 128 },
                    "parts": {
                      "maxItems": 128,
                      "type": "array",
                      "items": { "type": "string", "maxLength": 128 }
                    },
                    "relationship": { "type": "string", "maxLength": 128 },
                    "pack": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "maxLength": 128,
                          "pattern": "^[A-Za-z][\\w.-]*$"
                        },
                        "version": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^\\d+\\.\\d+\\.\\d+$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "variant": {
                          "type": "string",
                          "maxLength": 128,
                          "pattern": "^[A-Za-z][\\w.-]*$"
                        },
                        "detail": {
                          "type": "string",
                          "maxLength": 128,
                          "pattern": "^[A-Za-z][\\w.-]*$"
                        }
                      },
                      "required": [
                        "id",
                        "version",
                        "sha256",
                        "variant",
                        "detail"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": ["code", "message", "path"],
                  "additionalProperties": false
                },
                "retryable": { "type": "boolean" }
              },
              "required": [
                "number",
                "revision",
                "requestHash",
                "status",
                "stage",
                "startedUtc",
                "endedUtc",
                "seconds",
                "diagnostic",
                "retryable"
              ],
              "additionalProperties": false
            }
          },
          "product": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 536870912
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": ["path", "bytes", "sha256"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "priorProducts": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 536870912
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": ["path", "bytes", "sha256"],
              "additionalProperties": false
            }
          },
          "cacheFailures": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "requestHash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "atUtc": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "diagnostic": { "type": "string", "maxLength": 2048 }
              },
              "required": ["requestHash", "atUtc", "diagnostic"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "identityHash",
          "requestHash",
          "status",
          "attempts",
          "product",
          "priorProducts",
          "cacheFailures"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "manifestHash",
    "codeSha256",
    "profileSha256",
    "updatedUtc",
    "rows"
  ],
  "additionalProperties": false
}
