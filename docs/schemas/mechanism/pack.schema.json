            "type": "object",
            "properties": {
              "position": {
                "default": [0, 0, 0],
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
