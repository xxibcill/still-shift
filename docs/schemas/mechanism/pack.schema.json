{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "mechanism-pack-1" },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][\\w.-]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "family": {
      "type": "string",
      "enum": ["tape-hook", "cable-tie", "clothespeg"]
    },
    "status": { "type": "string", "enum": ["candidate", "verified"] },
    "generator": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][\\w.-]*$"
        },
        "version": { "type": "string", "const": "1" },
        "defaultSourceSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "parameterSchemaSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "defaultSourceSha256",
        "parameterSchemaSha256"
      ],
      "additionalProperties": false
    },
    "factualVariant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][\\w.-]*$"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "dimensionBasis": {
          "type": "string",
          "enum": ["illustrative", "measured"]
        },
        "sources": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "maxLength": 2048, "format": "uri" },
              "claim": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "required": ["url", "claim"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "description", "dimensionBasis", "sources"],
      "additionalProperties": false
    },
    "coordinateSystem": { "type": "string", "const": "right-handed-y-up" },
    "units": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["illustrative", "meter", "millimeter"]
        },
        "scaleToMeters": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      },
      "required": ["kind", "scaleToMeters"],
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "min": {
          "type": "array",
