                  { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                  { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
                ]
              },
              "pivot": {
                "default": [0, 0, 0],
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  { "type": "number", "minimum": -1000000, "maximum": 1000000 }
                ]
              }
            },
            "required": ["position", "rotation", "scale", "pivot"],
            "additionalProperties": false
          },
          "visible": { "default": true, "type": "boolean" }
        },
        "required": ["id", "transform", "visible"],
        "additionalProperties": false
      }
