      "required": ["min", "max"],
      "additionalProperties": false
    },
    "boundsPart": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][\\w.-]*$"
    },
    "parts": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
