{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mount": {
      "type": "object",
      "properties": {
        "position": {
          "default": [0, 0, 0],
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          ]
        },
        "rotation": {
          "default": [0, 0, 0],
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          ]
        },
        "scale": {
          "default": [1, 1, 1],
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
          ]
        },
        "pivot": {
          "default": [0, 0, 0],
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          ]
        }
      },
      "required": ["position", "rotation", "scale", "pivot"],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "color": { "type": "string", "pattern": "^#[\\da-f]{6}$" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "expectedPack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][\\w.-]*$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "variant": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][\\w.-]*$"
        },
        "detail": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][\\w.-]*$"
        }
      },
      "required": ["id", "version", "sha256", "variant", "detail"],
      "additionalProperties": false
    },
    "variant": {
      "type": "string",
      "enum": [
        "outside-serrated-integral-pawl-cutaway",
        "inside-serrated-extended-trigger-cutaway",
        "hinged-pawl-frame-stop"
      ]
    },
    "parameters": {
      "default": { "pitch": 0.5, "strapWidth": 1, "toothCount": 8 },
      "type": "object",
      "properties": {
        "pitch": {
          "default": 0.5,
          "type": "number",
          "minimum": 0.35,
          "maximum": 0.7
        },
        "strapWidth": {
          "default": 1,
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.4
        },
        "toothCount": {
          "default": 8,
          "type": "integer",
          "minimum": 6,
          "maximum": 12
        }
      },
      "required": ["pitch", "strapWidth", "toothCount"],
      "additionalProperties": false
    }
  },
  "required": ["parameters"],
  "additionalProperties": false
}
