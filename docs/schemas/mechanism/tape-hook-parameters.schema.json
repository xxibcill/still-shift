{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hookThickness": {
      "default": 0.18,
      "type": "number",
      "minimum": 0.04,
      "maximum": 0.35
    },
    "bladeLength": {
      "default": 10,
      "type": "number",
      "minimum": 4,
      "maximum": 20
    },
    "bladeWidth": { "default": 2, "type": "number", "minimum": 1, "maximum": 3 }
  },
  "required": ["hookThickness", "bladeLength", "bladeWidth"],
  "additionalProperties": false
}
