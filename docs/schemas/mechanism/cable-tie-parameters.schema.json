{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pitch": {
      "default": 0.5,
      "type": "number",
      "minimum": 0.35,
      "maximum": 0.7
    },
    "strapWidth": {
      "default": 1,
      "type": "number",
      "minimum": 0.65,
      "maximum": 1.4
    },
    "toothCount": {
      "default": 8,
      "type": "integer",
      "minimum": 6,
      "maximum": 12
    }
  },
  "required": ["pitch", "strapWidth", "toothCount"],
  "additionalProperties": false
}
