{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "mechanism-pack-timeline-1" },
    "frameCount": { "type": "integer", "minimum": 1, "maximum": 108000 },
    "initialState": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][\\w.-]*$"
    },
    "rigControls": {
      "default": {},
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z][\\w.-]*$"
      },
      "maxProperties": 8,
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "slider" },
              "value": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "keys": {
                "minItems": 1,
                "maxItems": 2000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "frame": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 108000
                    },
                    "value": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "easing": {
                      "default": "linear",
                      "type": "string",
                      "enum": ["linear", "smoothstep", "hold"]
                    }
                  },
                  "required": ["frame", "value", "easing"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "hinge" },
              "value": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "keys": {
                "minItems": 1,
                "maxItems": 2000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "frame": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 108000
                    },
                    "value": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "easing": {
                      "default": "linear",
                      "type": "string",
                      "enum": ["linear", "smoothstep", "hold"]
                    }
                  },
                  "required": ["frame", "value", "easing"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "load-seat" },
              "loadNewtons": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "keys": {
                    "minItems": 1,
                    "maxItems": 2000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "frame": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 108000
                        },
                        "value": {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        },
                        "easing": {
                          "default": "linear",
                          "type": "string",
                          "enum": ["linear", "smoothstep", "hold"]
                        }
                      },
                      "required": ["frame", "value", "easing"],
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["type", "loadNewtons"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "spring-return" },
              "states": {
                "minItems": 1,
                "maxItems": 2000,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "frame": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 108000
                        },
                        "phase": { "type": "string", "const": "held" },
                        "value": {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      "required": ["frame", "phase", "value"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "frame": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 108000
                        },
                        "phase": { "type": "string", "const": "released" },
                        "value": {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        },
                        "stopValue": {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      "required": ["frame", "phase", "value", "stopValue"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["type", "states"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "ratchet" },
              "position": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "keys": {
                    "minItems": 1,
                    "maxItems": 2000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "frame": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 108000
                        },
                        "value": {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        },
                        "easing": {
                          "default": "linear",
                          "type": "string",
                          "enum": ["linear", "smoothstep", "hold"]
                        }
                      },
                      "required": ["frame", "value", "easing"],
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "latchKeys": {
                "minItems": 1,
                "maxItems": 2000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "frame": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 108000
                    },
                    "state": {
                      "type": "string",
                      "enum": ["engaged", "released"]
                    }
                  },
                  "required": ["frame", "state"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type", "position", "latchKeys"],
            "additionalProperties": false
          }
        ]
      }
    },
    "states": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "requirements": {
            "minItems": 1,
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rig": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][\\w.-]*$"
                },
                "relationship": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][\\w.-]*$"
                },
                "signedGap": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  ]
                }
              },
              "required": ["rig", "relationship"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "requirements"],
        "additionalProperties": false
      }
    },
    "transitions": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "to": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "event": {
            "type": "string",
            "enum": ["contact", "release", "return", "reset"]
          }
        },
        "required": ["from", "to", "event"],
        "additionalProperties": false
      }
    },
    "events": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          },
          "frame": { "type": "number", "minimum": 0, "maximum": 108000 },
          "kind": {
            "type": "string",
            "enum": ["initial", "contact", "release", "return", "reset"]
          },
          "state": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][\\w.-]*$"
          }
        },
        "required": ["id", "frame", "kind", "state"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "frameCount",
    "initialState",
    "rigControls",
    "states",
    "transitions",
    "events"
  ],
  "additionalProperties": false
}
