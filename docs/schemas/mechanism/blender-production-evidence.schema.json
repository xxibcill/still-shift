{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "mechanism-production-evidence-2"
    },
    "backend": { "type": "string", "const": "blender-native" },
    "binding": {
      "type": "object",
      "properties": {
        "inputSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "outputSha256": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "codeSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "profileSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "inputSha256",
        "outputSha256",
        "codeSha256",
        "profileSha256"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "bytes", "sha256"],
      "additionalProperties": false
    },
    "decodedReport": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "bytes", "sha256"],
      "additionalProperties": false
    },
    "nativePlates": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "bytes", "sha256"],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "frameCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "fps": { "type": "integer", "exclusiveMinimum": 0, "maximum": 120 },
        "width": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "sourceSamples": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 172800000
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "samples": {
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frame": { "type": "integer", "minimum": 0, "maximum": 107999 },
              "roles": {
                "minItems": 1,
                "maxItems": 512,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "cue": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "entry",
                        "mid",
                        "exit",
                        "event-before",
                        "event-at",
                        "event-after",
                        "cut-before",
                        "cut-after"
                      ]
                    },
                    "origin": {
                      "type": "string",
                      "enum": [
                        "shot",
                        "control",
                        "source-frame",
                        "callout",
                        "speech"
                      ]
                    }
                  },
                  "required": ["cue", "kind", "origin"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["frame", "roles"],
            "additionalProperties": false
          }
        },
        "shots": {
          "minItems": 1,
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cue": { "type": "string", "minLength": 1, "maxLength": 256 },
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 107999
              },
              "endFrameExclusive": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 108000
              },
              "midFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 107999
              },
              "captionCrop": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "width": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["x", "y", "width", "height"],
                "additionalProperties": false
              },
              "anchors": {
                "maxItems": 16,
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 256 }
              },
              "detailFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 107999
              }
            },
            "required": [
              "cue",
              "startFrame",
              "endFrameExclusive",
              "midFrame",
              "captionCrop",
              "anchors",
              "detailFrame"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "frameCount",
        "fps",
        "width",
        "height",
        "sourceSamples",
        "sourceFingerprint",
        "samples",
        "shots"
      ],
      "additionalProperties": false
    },
    "images": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "required": ["path", "bytes", "sha256"],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": ["frame", "phone", "caption-crop", "anchor-crop"]
          },
          "outputFrame": { "type": "integer", "minimum": 0, "maximum": 107999 },
          "cue": {
            "anyOf": [
              { "type": "string", "maxLength": 256 },
              { "type": "null" }
            ]
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 8192
          },
          "pixelsSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "sourceFramePixelsSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "crop": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "width": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["x", "y", "width", "height"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "projections": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "pixel": {
                  "anyOf": [
                    {
                      "type": "array",
                      "prefixItems": [
                        { "type": "number" },
                        { "type": "number" }
                      ]
                    },
                    { "type": "null" }
                  ]
                },
                "visibility": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": ["anchor", "pixel", "visibility"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "file",
          "kind",
          "outputFrame",
          "cue",
          "width",
          "height",
          "pixelsSha256",
          "sourceFramePixelsSha256",
          "crop",
          "projections"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "file": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "required": ["path", "bytes", "sha256"],
          "additionalProperties": false
        },
        "decodedSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "decodedBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "samples": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
        "sampleRate": { "type": "number", "const": 48000 },
        "method": {
          "type": "string",
          "const": "unmodified-float32-PCM-from-final-output"
        }
      },
      "required": [
        "file",
        "decodedSha256",
        "decodedBytes",
        "samples",
        "channels",
        "sampleRate",
        "method"
      ],
      "additionalProperties": false
    },
    "exceptions": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cue": { "type": "string", "maxLength": 256 },
          "outputFrame": { "type": "integer", "minimum": 0, "maximum": 107999 },
          "reason": { "type": "string", "maxLength": 1024 },
          "projections": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "pixel": {
                  "anyOf": [
                    {
                      "type": "array",
                      "prefixItems": [
                        { "type": "number" },
                        { "type": "number" }
                      ]
                    },
                    { "type": "null" }
                  ]
                },
                "visibility": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": ["anchor", "pixel", "visibility"],
              "additionalProperties": false
            }
          }
        },
        "required": ["cue", "outputFrame", "reason", "projections"],
        "additionalProperties": false
      }
    },
    "qualification": { "type": "string", "maxLength": 2048 }
  },
  "required": [
    "schemaVersion",
    "backend",
    "binding",
    "output",
    "decodedReport",
    "nativePlates",
    "plan",
    "images",
    "audio",
    "exceptions",
    "qualification"
  ],
  "additionalProperties": false
}
