{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "mechanism-cue-compilation-1"
    },
    "family": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "revision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "projectHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "revision", "projectHash"],
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "revision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "projectHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "revision", "projectHash"],
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "frameCount": { "type": "integer", "minimum": 1, "maximum": 108000 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
    "width": { "type": "integer", "minimum": 16, "maximum": 8192 },
    "height": { "type": "integer", "minimum": 16, "maximum": 8192 }
  },
  "required": [
    "schemaVersion",
    "family",
    "cue",
    "composition",
    "frameCount",
    "fps",
    "width",
    "height"
  ],
  "additionalProperties": false
}
