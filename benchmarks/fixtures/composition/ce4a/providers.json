{
  "schemaVersion": "composition-1",
  "id": "provider-chart",
  "width": 100,
  "height": 100,
  "fps": 24,
  "frameCount": 24,
  "background": "#ffffff",
  "assets": [],
  "layers": [
    {
      "id": "brush",
      "type": "provider",
      "provider": "story.path@1.0.0",
      "assets": [],
      "usesSystemFonts": false,
      "bounds": [0, 0, 100, 100],
      "params": {
        "node": {
          "id": "brush",
          "type": "path",
          "points": [
            [10, 50],
            [90, 50]
          ],
          "stroke": "#211F1B",
          "lineWidth": 8,
          "lineStyle": "brush"
        },
        "samples": [{ "reveal": 1, "gap": 0, "pinch": 0, "pulse": 0 }]
      }
    }
  ]
}
