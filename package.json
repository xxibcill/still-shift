{
  "name": "still-shift",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic still-image animation engine spike",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "benchmark": "vitest bench --run benchmarks/noop.bench.ts",
    "browser:install": "playwright install chromium",
    "build": "tsc --noEmit",
    "check": "pnpm toolchain:check && pnpm schema:check && pnpm check:boundaries && pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "check:all": "pnpm check && pnpm benchmark && pnpm corpus:check",
    "corpus:check": "tsx scripts/check-corpus.ts",
    "depth:prepare": "uv run still-shift-depth prepare",
    "depth:contact-sheet": "uv run still-shift-depth contact-sheet",
    "evaluation:prepare": "tsx scripts/evaluation/prepare.ts",
    "evaluation:baselines": "tsx scripts/evaluation/baselines.ts",
    "evaluation:gallery": "tsx scripts/evaluation/gallery.ts",
    "evaluation:assemble": "tsx scripts/evaluation/assemble.ts",
    "evaluation:report": "tsx scripts/evaluation/report.ts",
    "illustrated:prepare": "node --import tsx scripts/create-illustrated-demos.ts",
    "illustrated:render": "node --import tsx scripts/render-illustrated-demos.ts",
    "cinematic:prepare": "node --import tsx scripts/create-cinematic-demos.ts",
    "cinematic:render": "node --import tsx scripts/render-cinematic-demos.ts",
    "test:browser:cinematic": "node --import tsx tests/browser/cinematic.ts",
    "test:browser:cinematic:vertical": "node --import tsx tests/browser/vertical-cinematic.ts",
    "test:browser:threshold": "node --import tsx tests/browser/cinematic.ts --preset threshold_push",
    "test:browser:dolly": "node --import tsx tests/browser/cinematic.ts --preset dolly_zoom_tension",
    "threshold:render": "node --import tsx scripts/render-cinematic-demos.ts --preset threshold_push",
    "lab": "vite --config apps/lab/vite.config.ts",
    "format": "prettier --write \"{apps,benchmarks,docs,packages,scripts,services,tests,tools}/**/*.{css,html,json,md,mts,ts}\" \"*.{json,mts,yaml,yml}\" README.md ROADMAP.md && uv run ruff format services/depth-worker packages/execution-runtime/src/artifact-lock-helper.py",
    "format:check": "prettier --check \"{apps,benchmarks,docs,packages,scripts,services,tests,tools}/**/*.{css,html,json,md,mts,ts}\" \"*.{json,mts,yaml,yml}\" README.md ROADMAP.md && uv run ruff format --check services/depth-worker packages/execution-runtime/src/artifact-lock-helper.py",
    "lint": "eslint . && uv run ruff check services/depth-worker packages/execution-runtime/src/artifact-lock-helper.py",
    "schema:check": "node --import tsx scripts/generate-corpus-schema.ts --check",
    "schema:generate": "node --import tsx scripts/generate-corpus-schema.ts",
    "still-shift": "tsx tools/still-shift-cli/src/cli.ts",
    "test": "pnpm test:unit && pnpm test:runtime && pnpm test:integration && pnpm test:depth && pnpm test:browser:depth && pnpm test:browser:vertical-image && pnpm test:browser:export && pnpm test:golden && pnpm test:browser:cli && pnpm test:browser:batch && pnpm test:browser:illustrated && pnpm test:browser:illustrated:vertical && pnpm test:browser:cinematic && pnpm test:browser:cinematic:vertical && pnpm test:browser:threshold && pnpm test:browser:dolly && pnpm test:browser:lateral && pnpm test:browser:reveal && pnpm test:browser:story && pnpm test:browser:story:activity && pnpm test:browser:story:continuous && pnpm test:browser:passage:authoring && pnpm test:browser:lab-session && pnpm test:browser:commerce && pnpm test:browser:commerce-components && pnpm test:browser:commerce-effects && pnpm test:browser:commerce-spatial && pnpm test:browser:reusable-components && pnpm test:browser:reusable-package && pnpm test:browser:reusable-behavior-package && pnpm test:browser:reusable-timing-package && pnpm test:browser:typography && pnpm test:browser:typography:fixtures && pnpm test:browser:composition-evaluator && pnpm test:browser:composition-expressions && pnpm test:browser:composition && pnpm test:browser:composition-webgl && pnpm test:browser:composition-webgl-export && pnpm test:browser:composition-exposure && pnpm test:browser:composition-effects && pnpm test:browser:composition-story-adapter && pnpm test:browser:composition-story-fixtures && pnpm test:browser:composition-commerce-adapter && pnpm test:browser:composition-typography-adapter && pnpm test:browser:composition-provider-typography && pnpm test:browser:composition-baselines",
    "test:browser:illustrated": "node --import tsx tests/browser/illustrated.ts",
    "test:browser:batch": "tsx tests/browser/batch-cli.ts",
    "test:browser:depth": "tsx tests/browser/depth-motion.ts",
    "test:browser:vertical-image": "tsx tests/browser/vertical-image.ts",
    "test:browser:export": "tsx tests/browser/export-worker.ts",
    "test:browser:cli": "tsx tests/browser/real-cli.ts",
    "test:golden": "tsx tests/browser/golden-parity.ts",
    "test:depth": "uv run --no-sync python -m unittest discover -s services/depth-worker/tests -p 'test_*.py'",
    "test:integration": "vitest run tests/integration --maxWorkers=2 --no-file-parallelism",
    "test:unit": "vitest run tests/unit --maxWorkers=4",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "lateral:render": "node --import tsx scripts/render-cinematic-demos.ts --preset lateral_track",
    "test:browser:lateral": "node --import tsx tests/browser/cinematic.ts --preset lateral_track",
    "reveal:render": "node --import tsx scripts/render-cinematic-demos.ts --preset foreground_reveal",
    "test:browser:reveal": "node --import tsx tests/browser/cinematic.ts --preset foreground_reveal",
    "cinematic:preview": "node --import tsx scripts/preview-cinematic.ts",
    "story:prepare": "node --import tsx scripts/create-story-demos.ts",
    "story:sequence:prepare": "node --import tsx scripts/create-illustrated-sequence.ts",
    "story:sequence:sound": "node --import tsx scripts/create-sound-sequence.ts",
    "story:sequence:narrated": "node --import tsx scripts/create-narrated-sequence.ts",
    "story:render": "node --import tsx scripts/render-story-demos.ts",
    "story:proof": "node --import tsx scripts/render-story-proof.ts",
    "story:passage": "node --import tsx scripts/prepare-story-passage.ts",
    "story:package": "node --import tsx scripts/package-story-workspace.ts",
    "test:browser:passage": "node --import tsx tests/browser/story-passage.ts",
    "story:compare": "node --import tsx scripts/compare-story-demos.ts",
    "test:browser:story": "node --import tsx tests/browser/story.ts",
    "test:browser:story:activity": "node --import tsx tests/browser/story-activity.ts",
    "commerce:prepare": "node --import tsx scripts/create-commerce-demos.ts",
    "test:browser:commerce": "node --import tsx tests/browser/commerce.ts",
    "commerce:components:prepare": "node --import tsx scripts/create-commerce-components.ts",
    "test:browser:commerce-components": "node --import tsx tests/browser/commerce-components.ts",
    "test:browser:commerce-effects": "node --import tsx tests/browser/commerce-effects.ts",
    "test:browser:commerce-spatial": "node --import tsx tests/browser/commerce-spatial.ts",
    "story:review": "node --import tsx scripts/publish-story-review.ts",
    "test:browser:passage:authoring": "node --import tsx tests/browser/passage-authoring.ts",
    "test:browser:story:continuous": "node --import tsx tests/browser/story-continuous.ts",
    "components:prepare": "node --import tsx scripts/create-reusable-components.ts",
    "test:browser:reusable-components": "node --import tsx tests/browser/reusable-components.ts",
    "test:browser:reusable-package": "node --import tsx tests/browser/reusable-component-package.ts",
    "test:browser:reusable-behavior-package": "node --import tsx tests/browser/reusable-component-package.ts --behaviors",
    "test:browser:reusable-timing-package": "node --import tsx tests/browser/reusable-component-package.ts --timing",
    "test:fast": "pnpm test:unit",
    "test:runtime": "vitest run tests/runtime --maxWorkers=2 --no-file-parallelism",
    "test:browser:smoke": "pnpm test:browser:lab-session && node --import tsx tests/browser/reusable-components.ts --smoke-only --ui-export --timing-only",
    "check:boundaries": "node --import tsx scripts/check-package-boundaries.ts",
    "format:check:ts": "prettier --check \"{apps,benchmarks,docs,packages,scripts,services,tests,tools}/**/*.{css,html,json,md,mts,ts}\" \"*.{json,mts,yaml,yml}\" README.md ROADMAP.md",
    "lint:ts": "eslint .",
    "check:fast": "pnpm schema:check && pnpm check:boundaries && pnpm format:check:ts && pnpm lint:ts && pnpm build && pnpm test:fast",
    "check:runtime": "pnpm toolchain:check && pnpm test:runtime && pnpm test:integration && pnpm test:depth && pnpm test:browser:smoke",
    "test:browser:lab-session": "node --import tsx tests/browser/lab-session.ts",
    "test:browser:motion-craft": "node --import tsx tests/browser/motion-craft.ts",
    "test:browser:illustrated:vertical": "node --import tsx tests/browser/vertical-illustrated.ts",
    "story:type-specimen": "node --import tsx scripts/story-type-specimen.ts",
    "test:browser:typography": "node --import tsx tests/browser/typography.ts",
    "test:browser:typography:fixtures": "node --import tsx tests/browser/typography-fixtures.ts",
    "typography:prepare": "node --import tsx scripts/story-motion/create-typography-fixtures.ts",
    "composition:hardware-preview": "node --import tsx scripts/composition/hardware-preview.ts",
    "composition:baselines": "node --import tsx scripts/composition/baselines.ts",
    "test:browser:composition-baselines": "node --import tsx scripts/composition/baselines.ts --check",
    "test:browser:composition": "node --import tsx tests/browser/composition.ts",
    "test:browser:composition-evaluator": "node --import tsx tests/browser/composition-evaluator.ts",
    "test:browser:composition-expressions": "node --import tsx tests/browser/composition-expressions.ts",
    "test:browser:composition-story-adapter": "node --import tsx tests/browser/composition-story-adapter.ts",
    "test:browser:composition-commerce-adapter": "node --import tsx tests/browser/composition-commerce-adapter.ts",
    "test:browser:composition-story-fixtures": "node --import tsx tests/browser/composition-story-fixtures.ts",
    "test:browser:composition-typography-adapter": "node --import tsx tests/browser/composition-typography-adapter.ts",
    "test:browser:composition-provider-typography": "node --import tsx tests/browser/composition-provider-typography.ts",
    "test:browser:composition-effects": "node --import tsx tests/browser/composition-effects.ts",
    "test:browser:composition-exposure": "node --import tsx tests/browser/composition-exposure.ts",
    "test:browser:composition-webgl": "node --import tsx tests/browser/composition-webgl.ts",
    "test:browser:composition-webgl-blur": "node --import tsx tests/browser/composition-webgl-blur.ts",
    "test:browser:composition-webgl-export": "node --import tsx tests/browser/composition-webgl-export.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "image-size": "2.0.2",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "zod": "4.1.5",
    "@still-shift/execution-runtime": "workspace:*"
  }
}
