{
  "name": "still-shift",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic still-image animation engine spike",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "benchmark": "vitest bench --run benchmarks/noop.bench.ts",
    "browser:install": "playwright install chromium",
    "build": "tsc --noEmit",
    "check": "pnpm toolchain:check && pnpm schema:check && pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "check:all": "pnpm check && pnpm benchmark && pnpm corpus:check",
    "corpus:check": "tsx scripts/check-corpus.ts",
    "depth:prepare": "uv run still-shift-depth prepare",
    "depth:contact-sheet": "uv run still-shift-depth contact-sheet",
    "evaluation:prepare": "tsx scripts/evaluation/prepare.ts",
    "evaluation:baselines": "tsx scripts/evaluation/baselines.ts",
    "evaluation:gallery": "tsx scripts/evaluation/gallery.ts",
    "evaluation:assemble": "tsx scripts/evaluation/assemble.ts",
    "evaluation:report": "tsx scripts/evaluation/report.ts",
    "illustrated:prepare": "node --import tsx scripts/create-illustrated-demos.ts",
    "illustrated:render": "node --import tsx scripts/render-illustrated-demos.ts",
    "cinematic:prepare": "node --import tsx scripts/create-cinematic-demos.ts",
    "cinematic:render": "node --import tsx scripts/render-cinematic-demos.ts",
    "test:browser:cinematic": "node --import tsx tests/browser/cinematic.ts",
    "test:browser:threshold": "node --import tsx tests/browser/cinematic.ts --preset threshold_push",
    "threshold:render": "node --import tsx scripts/render-cinematic-demos.ts --preset threshold_push",
    "lab": "vite --config apps/lab/vite.config.ts",
    "format": "prettier --write \"{apps,benchmarks,docs,packages,scripts,services,tests,tools}/**/*.{css,html,json,md,mts,ts}\" \"*.{json,mts,yaml,yml}\" README.md ROADMAP.md && uv run ruff format services/depth-worker",
    "format:check": "prettier --check \"{apps,benchmarks,docs,packages,scripts,services,tests,tools}/**/*.{css,html,json,md,mts,ts}\" \"*.{json,mts,yaml,yml}\" README.md ROADMAP.md && uv run ruff format --check services/depth-worker",
    "lint": "eslint . && uv run ruff check services/depth-worker",
    "schema:check": "tsx scripts/generate-corpus-schema.ts --check",
    "schema:generate": "tsx scripts/generate-corpus-schema.ts",
    "still-shift": "tsx tools/still-shift-cli/src/cli.ts",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:depth && pnpm test:browser:depth && pnpm test:browser:export && pnpm test:golden && pnpm test:browser:cli && pnpm test:browser:batch && pnpm test:browser:illustrated && pnpm test:browser:cinematic && pnpm test:browser:threshold && pnpm test:browser:lateral && pnpm test:browser:reveal && pnpm test:browser:story && pnpm test:browser:commerce && pnpm test:browser:commerce-components && pnpm test:browser:commerce-effects && pnpm test:browser:commerce-spatial",
    "test:browser:illustrated": "node --import tsx tests/browser/illustrated.ts",
    "test:browser:batch": "tsx tests/browser/batch-cli.ts",
    "test:browser:depth": "tsx tests/browser/depth-motion.ts",
    "test:browser:export": "tsx tests/browser/export-worker.ts",
    "test:browser:cli": "tsx tests/browser/real-cli.ts",
    "test:golden": "tsx tests/browser/golden-parity.ts",
    "test:depth": "uv run --no-sync python -m unittest discover -s services/depth-worker/tests -p 'test_*.py'",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "lateral:render": "node --import tsx scripts/render-cinematic-demos.ts --preset lateral_track",
    "test:browser:lateral": "node --import tsx tests/browser/cinematic.ts --preset lateral_track",
    "reveal:render": "node --import tsx scripts/render-cinematic-demos.ts --preset foreground_reveal",
    "test:browser:reveal": "node --import tsx tests/browser/cinematic.ts --preset foreground_reveal",
    "cinematic:preview": "node --import tsx scripts/preview-cinematic.ts",
    "story:prepare": "node --import tsx scripts/create-story-demos.ts",
    "story:render": "node --import tsx scripts/render-story-demos.ts",
    "story:proof": "node --import tsx scripts/render-story-proof.ts",
    "story:compare": "node --import tsx scripts/compare-story-demos.ts",
    "test:browser:story": "node --import tsx tests/browser/story.ts",
    "commerce:prepare": "node --import tsx scripts/create-commerce-demos.ts",
    "test:browser:commerce": "node --import tsx tests/browser/commerce.ts",
    "commerce:components:prepare": "node --import tsx scripts/create-commerce-components.ts",
    "test:browser:commerce-components": "node --import tsx tests/browser/commerce-components.ts",
    "test:browser:commerce-effects": "node --import tsx tests/browser/commerce-effects.ts",
    "test:browser:commerce-spatial": "node --import tsx tests/browser/commerce-spatial.ts",
    "story:review": "node --import tsx scripts/publish-story-review.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "image-size": "2.0.2",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "zod": "4.1.5"
  }
}
